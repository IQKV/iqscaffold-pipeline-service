<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="20251110168000-create-tenant-info-table" author="iqscaffold" context="public">
        <comment>Create tenant_info table for pipeline service tenant management (public schema)</comment>
        
        <createTable tableName="tenant_info" schemaName="public">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="schema_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="tenant_info" indexName="idx_tenant_info_tenant_id" schemaName="public">
            <column name="tenant_id"/>
        </createIndex>

        <createIndex tableName="tenant_info" indexName="idx_tenant_info_schema_name" schemaName="public">
            <column name="schema_name"/>
        </createIndex>

        <createIndex tableName="tenant_info" indexName="idx_tenant_info_status" schemaName="public">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="tenant_info" indexName="idx_tenant_info_status" schemaName="public"/>
            <dropIndex tableName="tenant_info" indexName="idx_tenant_info_schema_name" schemaName="public"/>
            <dropIndex tableName="tenant_info" indexName="idx_tenant_info_tenant_id" schemaName="public"/>
            <dropTable tableName="tenant_info" schemaName="public"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
